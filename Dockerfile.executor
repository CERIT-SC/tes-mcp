FROM ubuntu:26.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PIP_BREAK_SYSTEM_PACKAGES=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        git \
        fakeroot \
        build-essential \
        nodejs \
        npm \
        python3 \
        python3-pip \
        python-is-python3 \
        r-base \
        r-base-dev \
    && python3 -m pip install --no-cache-dir uv \
    && python3 -m pip install --no-cache-dir \
        matplotlib \
        numpy \
        pandas \
        scipy \
        scikit-learn \
        seaborn \
        statsmodels \
        biopython \
        sqlalchemy \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /data
